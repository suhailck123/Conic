{
  "businesses": {
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "_id",
          "name",
          "currency",
          "openingOnlineBalance",
          "openingCashBalance",
          "vendors",
          "expenseCategories"
        ],
        "properties": {
          "_id": {
            "bsonType": "string"
          },
          "name": {
            "bsonType": "string"
          },
          "currency": {
            "enum": [
              "INR"
            ]
          },
          "dateFormat": {
            "bsonType": "string"
          },
          "openingOnlineBalance": {
            "bsonType": "number"
          },
          "openingCashBalance": {
            "bsonType": "number"
          },
          "vendors": {
            "bsonType": "array",
            "items": {
              "bsonType": "string"
            }
          },
          "expenseCategories": {
            "bsonType": "array",
            "items": {
              "bsonType": "string"
            }
          },
          "updatedAt": {
            "bsonType": "date"
          }
        }
      }
    },
    "indexes": [
      {
        "name": 1
      }
    ]
  },
  "dailyEntries": {
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "businessId",
          "date",
          "onlineSales",
          "cashSales",
          "expenses",
          "expensePaidOnline",
          "expensePaidCash"
        ],
        "properties": {
          "businessId": {
            "bsonType": "string"
          },
          "date": {
            "bsonType": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "onlineSales": {
            "bsonType": "number"
          },
          "cashSales": {
            "bsonType": "number"
          },
          "expenses": {
            "bsonType": "object"
          },
          "expensePaidOnline": {
            "bsonType": "number"
          },
          "expensePaidCash": {
            "bsonType": "number"
          },
          "notes": {
            "bsonType": "string"
          },
          "createdAt": {
            "bsonType": "date"
          },
          "updatedAt": {
            "bsonType": "date"
          }
        }
      }
    },
    "indexes": [
      {
        "businessId": 1,
        "date": 1
      },
      {
        "businessId": 1,
        "date": -1
      }
    ]
  },
  "purchaseEntries": {
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "businessId",
          "purchaseDate",
          "vendorAmounts",
          "onlinePurchasePaid",
          "cashPurchasePaid"
        ],
        "properties": {
          "businessId": {
            "bsonType": "string"
          },
          "purchaseDate": {
            "bsonType": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "paymentDate": {
            "bsonType": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "vendorAmounts": {
            "bsonType": "object"
          },
          "onlinePurchasePaid": {
            "bsonType": "number"
          },
          "cashPurchasePaid": {
            "bsonType": "number"
          },
          "createdAt": {
            "bsonType": "date"
          },
          "updatedAt": {
            "bsonType": "date"
          }
        }
      }
    },
    "indexes": [
      {
        "businessId": 1,
        "purchaseDate": 1
      },
      {
        "businessId": 1,
        "paymentDate": 1
      }
    ]
  },
  "users": {
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "email",
          "businessId",
          "role"
        ],
        "properties": {
          "email": {
            "bsonType": "string"
          },
          "passwordHash": {
            "bsonType": "string"
          },
          "businessId": {
            "bsonType": "string"
          },
          "role": {
            "enum": [
              "owner",
              "staff",
              "viewer"
            ]
          },
          "createdAt": {
            "bsonType": "date"
          }
        }
      }
    },
    "indexes": [
      {
        "email": 1
      },
      {
        "businessId": 1,
        "email": 1
      }
    ]
  },
  "auditLogs": {
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "businessId",
          "action",
          "collection",
          "createdAt"
        ],
        "properties": {
          "businessId": {
            "bsonType": "string"
          },
          "userId": {
            "bsonType": "string"
          },
          "action": {
            "bsonType": "string"
          },
          "collection": {
            "bsonType": "string"
          },
          "documentId": {
            "bsonType": "string"
          },
          "before": {
            "bsonType": "object"
          },
          "after": {
            "bsonType": "object"
          },
          "createdAt": {
            "bsonType": "date"
          }
        }
      }
    },
    "indexes": [
      {
        "businessId": 1,
        "createdAt": -1
      }
    ]
  }
}